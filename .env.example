# Port of the web screen (portfolio demo default: 4601)
PORT=4601
HOST=127.0.0.1
# Where the seeded fake sources and the local memory/history live
DATA_DIR=./data
# Per-source deadline: a slow source is cut off and its section is marked unavailable
SOURCE_TIMEOUT_MS=6000
# Key used to decrypt the (synthetic) external-connection strings stored in the city databases
CONNECTION_KEY=demo-only-key-change-me
