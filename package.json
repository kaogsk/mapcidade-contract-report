{
  "name": "mapcidade-contract-report",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Builds a city's Contract Summary Report (.docx) from several unreliable sources — city database, VM disks, helpdesk mirror and helpdesk API — with a review screen before generation.",
  "engines": { "node": ">=22.13.0" },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "seed": "tsx src/seed-cli.ts",
    "generate": "tsx src/cli.ts",
    "template": "tsx src/docx/build-template-cli.ts",
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.0",
    "fast-xml-parser": "^4.5.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
